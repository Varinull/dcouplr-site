                  <!-- Client-Side Filter Script for Layer-by-Layer Matrix Table -->
                  <script>
                    (function() {
                      const searchInput = document.getElementById("layer-matrix-search");
                      const layerFilter = document.getElementById("layer-matrix-filter-layer");
                      const sevFilter = document.getElementById("layer-matrix-filter-severity");
                      const tableRows = document.querySelectorAll("#tbody-layer-coverage-matrix tr.layer-matrix-row");

                      function filterMatrixTable() {
                        const term = (searchInput ? searchInput.value.toLowerCase().trim() : "");
                        const selectedLayer = (layerFilter ? layerFilter.value : "ALL");
                        const selectedSev = (sevFilter ? sevFilter.value : "ALL");

                        tableRows.forEach(row => {
                          const rowLayer = row.getAttribute("data-layer") || "";
                          const rowSev = row.getAttribute("data-severity") || "";
                          const rowText = row.innerText.toLowerCase();

                          const matchesSearch = !term || rowText.includes(term);
                          const matchesLayer = selectedLayer === "ALL" || rowLayer === selectedLayer;
                          const matchesSev = selectedSev === "ALL" || rowSev.includes(selectedSev);

                          if (matchesSearch && matchesLayer && matchesSev) {
                            row.style.display = "";
                          } else {
                            row.style.display = "none";
                          }
                        });
                      }

                      if (searchInput) searchInput.addEventListener("input", filterMatrixTable);
                      if (layerFilter) layerFilter.addEventListener("change", filterMatrixTable);
                      if (sevFilter) sevFilter.addEventListener("change", filterMatrixTable);
                    })();
                  </script>


