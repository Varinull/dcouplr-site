                  <a href="/docs/runbooks/RUNBOOK-TECHNOLOGY-SPECIFIC-NODE-MONITORING-AND-ALERT-ROUTING.html" target="_blank" style="padding: 4px 10px; font-size: 0.72rem; font-weight: 700; background: #c084fc; color: #000; border-radius: 4px; text-decoration: none;">
