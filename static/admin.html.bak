                          </div>
                        </td>
                        <td style="padding: 12px;">
                          <span style="background: rgba(57,255,20,0.15); border: 1px solid rgba(57,255,20,0.35); color: #39ff14; font-weight: 700; padding: 2px 7px; border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono);">OPERATIONAL</span>
                        </td>
