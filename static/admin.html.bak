<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>&lt;dcouplr/&gt;: Project Record Assistant &amp; Document Administration</title>
  <meta name="description" content="Central administration portal for storing, inspecting, and managing all &lt;dcouplr/&gt; Project Record Assistant documents, financial models, governance charters, and technical whitepapers.">
  <link rel="stylesheet" href="/static/styles.css?v=5">
  <link rel="icon" type="image/png" href="/static/favicon.png?v=4">
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=4">
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body class="admin-body">
  <!-- Header -->
  <header>
    <div class="logo-area">
      <a href="/" class="brand-link" aria-label="Return to &lt;dcouplr/&gt; Home">
        <div class="dcouplr-logo" title="&lt;dcouplr/&gt;">
          <span class="dcouplr-bracket">&lt;</span><span class="dcouplr-text">dcouplr</span><span class="dcouplr-bracket">/&gt;</span>
        </div>
        <div class="brand-text">
          <span class="badge-tag">Admin Vault</span>
        </div>
      </a>
    </div>

    <nav class="nav-links" aria-label="Global Navigation">
      <a href="/" class="nav-link" id="nav-home">Homepage</a>
      <a href="/compiler" class="nav-link" id="nav-compiler">⚡ Compiler Studio (App)</a>
      <a href="/dashboard" class="nav-link" id="nav-dashboard">📊 Telemetry &amp; Topology Dashboard</a>
      <a href="/configuration" class="nav-link" id="nav-configuration">⚙️ Configuration (7-Tier &amp; NOC Hub)</a>
      <a href="/traces" class="nav-link" id="nav-traces" title="In-VPC APM Traces (<dcouplr/> Full-Stack Suite)">APM Traces</a>
      <a href="/logs" class="nav-link" id="nav-logs" title="In-VPC High-Throughput Log Search (<dcouplr/> Full-Stack Suite)">Log Search</a>
      <a href="/admin" class="nav-link active" id="nav-admin">Admin Vault</a>
      <button type="button" class="nav-link nav-btn-tab" id="nav-presentation" title="Open Presentation Dossier inside Vault">📊 Dossier Deck</button>
      <button type="button" class="nav-link nav-btn-tab" id="nav-api-catalog" title="Open Complete API Inventory inside Vault">🔌 Full API Catalog</button>
      <a href="/admin/swagger" target="_blank" class="nav-link" id="nav-docs" title="Full Administrator Swagger UI (All 3 Tiers)">API Swagger ↗</a>
    </nav>

    <div class="nav-badges">
      <div class="status-pill" style="background: rgba(57, 255, 20, 0.12); color: #39ff14; border: 1px solid rgba(57, 255, 20, 0.3);" title="Theorem 2 Kirchhoff Flux Invariant: SAT ($0.00 Egress)">
        <span class="pulse-dot" style="background: #39ff14;"></span>
        <span>Invariant SAT &bull; Thm 2</span>
      </div>
      <div class="status-pill">
        <span class="pulse-dot"></span>
        <span id="doc-count-badge">Loading documents...</span>
      </div>
      <div class="fidelity-badge">
        <span>VPC Storage:</span>
        <span id="storage-status">Secure Local</span>
      </div>
      <button id="btn-lock-admin" class="btn-lock-header" type="button" title="Lock the administrator portal">🔒 Lock</button>
    </div>
  </header>

  <script>
    (function() {
      try {
        var params = new URLSearchParams(window.location.search);
        if (params.get('auth') === '1' || params.get('token') || sessionStorage.getItem('dcouplr_admin_session_token')) {
          document.write('<style>#admin-gate-overlay { display: none !important; opacity: 0 !important; visibility: hidden !important; pointer-events: none !important; } #admin-workspace-content { display: block !important; }</style>');
        }
        if (params.get('view') === 'database-ssot' || params.get('view') === 'ssot' || window.location.hash === '#ssot') {
          document.write('<style>#database-ssot-area { display: block !important; } #markdown-render-area, #editor-area, #dossier-area, #blueprints-area, #api-catalog-area { display: none !important; }</style>');
        }
      } catch(e) {}
    })();
  </script>

  <!-- Security Gate Overlay Modal -->
  <div id="admin-gate-overlay" class="admin-gate-overlay">
    <div class="admin-gate-card">
      <div class="gate-shield-icon">🛡️</div>
      <h2 class="gate-title"><span class="dcouplr-bracket">&lt;</span><span class="dcouplr-text">dcouplr</span><span class="dcouplr-bracket">/&gt;</span> Security Gate</h2>
      <p class="gate-sub">Restricted Enterprise Governance Vault. Please sign in to inspect governance records, engineering lifecycles, and the master Presentation Dossier.</p>
      
      <form class="gate-form" id="gate-auth-form" onsubmit="return false;">
        <div>
          <label for="admin-user-input">Administrator Username</label>
          <div class="gate-input-wrapper">
            <input 
              type="text" 
              id="admin-user-input" 
              class="gate-input" 
              value="admin" 
              placeholder="Username (e.g. admin)" 
              autocomplete="username" 
              required
            >
          </div>
        </div>

        <div>
          <label for="admin-pass-input">Administrator Password / Key</label>
          <div class="gate-input-wrapper">
            <input 
              type="password" 
              id="admin-pass-input" 
              class="gate-input" 
              placeholder="Enter password..." 
              autocomplete="current-password" 
              required
            >
          </div>
        </div>

        <div id="gate-error-banner" class="gate-error">
          ⚠️ Invalid administrator credentials. Access denied.
        </div>

        <button id="btn-unlock-gate" class="btn-gate-submit" type="submit">
          🔓 Unlock Administrator Vault
        </button>
      </form>

      <!-- Enterprise SSO Section -->
      <div class="gate-sso-section" id="gate-sso-section" style="margin-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1.1rem;">
        <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; text-align: center; margin-bottom: 0.75rem; font-weight: 600;">
          Enterprise Single Sign-On (OIDC / OAuth2)
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
          <a href="/v1/auth/sso/okta/login" id="btn-sso-okta" class="btn-sso btn-sso-okta" style="display: flex; align-items: center; justify-content: center; gap: 0.45rem; padding: 0.65rem 0.8rem; border-radius: 8px; background: rgba(0, 122, 255, 0.12); border: 1px solid rgba(0, 122, 255, 0.35); color: #60a5fa; text-decoration: none; font-size: 0.82rem; font-weight: 600; transition: all 0.2s ease;">
            <span>🔵</span> Okta SSO
          </a>
          <a href="/v1/auth/sso/azure/login" id="btn-sso-azure" class="btn-sso btn-sso-azure" style="display: flex; align-items: center; justify-content: center; gap: 0.45rem; padding: 0.65rem 0.8rem; border-radius: 8px; background: rgba(0, 164, 239, 0.12); border: 1px solid rgba(0, 164, 239, 0.35); color: #38bdf8; text-decoration: none; font-size: 0.82rem; font-weight: 600; transition: all 0.2s ease;">
            <span>🔷</span> Azure Entra ID
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Admin Main Workspace -->
  <main class="admin-main" id="admin-workspace-content">
    <!-- Top Filter Bar -->
    <section class="control-bar admin-toolbar" aria-label="Document Administration Toolbar">
      <div class="search-input-group">
        <span class="search-icon">🔍</span>
        <input 
          type="text" 
          id="doc-search" 
          placeholder="Search project documents by title, path, or keyword..." 
          aria-label="Search project documents"
        >
      </div>

      <div class="category-filters" id="category-filters">
        <button class="filter-btn active" data-category="ALL" type="button">All Documents</button>
        <button class="filter-btn" data-category="Project Record Assistant (Governance)" type="button">🏛️ Governance &amp; Records</button>
        <button class="filter-btn" data-category="Financial & Commercial Models" type="button">💰 Financial &amp; GTM</button>
        <button class="filter-btn" data-category="Technical Specifications & Whitepapers" type="button">📐 Technical &amp; Whitepapers</button>
        <button class="filter-btn" data-category="Kubernetes & Deployment Manifests" type="button">🚀 Deployments</button>
        <span class="filter-divider" style="opacity: 0.3; padding: 0 4px;">|</span>
        <button class="filter-btn" data-category="SDLC" type="button">SDLC</button>
        <button class="filter-btn" data-category="ITIL" type="button">ITIL</button>
        <button class="filter-btn" data-category="PM" type="button">PM</button>
        <button class="filter-btn" data-category="DELIVERY" type="button">Delivery</button>
      </div>

      <div class="action-buttons-group">
        <button id="btn-top-database-ssot" class="btn-secondary" type="button" title="Inspect Dual-Database Architecture & SSoT Verification" style="display: inline-flex; align-items: center; gap: 6px; border-color: rgba(57, 255, 20, 0.4); color: #39ff14;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
          <span>🗄️ Dual-DB SSoT</span>
        </button>
        <button id="btn-view-dossier" class="btn-primary-dossier" type="button" title="View Executive Presentation Dossier inside the vault">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>Presentation Dossier</span>
        </button>
        <button id="btn-new-doc" class="btn-primary" type="button">
          ➕ New Record Document
        </button>
      </div>
    </section>

    <!-- Split Screen: Document List Sidebar & Document Stage -->
    <div class="admin-workspace-grid">
      <!-- Left Sidebar: Documents Explorer -->
      <aside class="panel-card doc-sidebar-panel" aria-label="Document Explorer">
        <div class="panel-header">
          <div class="panel-title">
            <span>📑 Document Explorer</span>
            <span class="panel-badge" id="visible-doc-count">0 items</span>
          </div>
          <button id="btn-refresh-docs" class="btn-secondary" type="button" title="Refresh from disk">🔄 Refresh</button>
        </div>

        <!-- Document Sorting & Grouping Controls -->
        <div class="doc-sort-bar" id="doc-sort-bar" style="margin: 0.5rem 0.75rem 0.5rem 0.75rem; padding: 0.45rem 0.65rem; background: rgba(15, 23, 42, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 6px; display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
          <div style="display: flex; align-items: center; gap: 0.35rem; flex: 1; min-width: 0;">
            <label for="doc-sort-select" style="font-size: 0.72rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;">
              📅 Sort:
            </label>
            <select id="doc-sort-select" class="doc-sort-select" aria-label="Sort documents list" style="flex: 1; min-width: 0; padding: 4px 6px; font-size: 0.74rem; font-weight: 600; background: #0b1120; color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 5px; cursor: pointer; outline: none;">
              <option value="created-desc">📅 Created (Newest First)</option>
              <option value="created-asc">📅 Created (Oldest First)</option>
              <option value="modified-desc">🕒 Modified (Recent First)</option>
              <option value="modified-asc">🕒 Modified (Oldest First)</option>
              <option value="title-asc">🔤 Title (A → Z)</option>
              <option value="title-desc">🔤 Title (Z → A)</option>
              <option value="size-desc">📦 Size (Largest First)</option>
              <option value="size-asc">📦 Size (Smallest First)</option>
            </select>
          </div>
          <button id="btn-toggle-grouping" type="button" class="btn-group-toggle" title="Toggle Category Grouping or Flat List" style="padding: 4px 7px; font-size: 0.72rem; font-weight: 600; background: rgba(99, 102, 241, 0.15); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.35); border-radius: 5px; cursor: pointer; white-space: nowrap;">
            📂 Grouped
          </button>
        </div>

        <!-- Featured Presentation Dossier Anchor inside Admin Vault -->
        <div class="sidebar-dossier-card" id="sidebar-dossier-card" style="margin: 0.75rem 0.75rem 0.5rem 0.75rem; padding: 0.85rem 0.95rem; background: linear-gradient(145deg, rgba(79, 70, 229, 0.15) 0%, rgba(14, 165, 233, 0.1) 100%); border: 1px solid rgba(99, 102, 241, 0.35); border-radius: 8px; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);">
          <div class="dossier-card-header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.4rem;">
            <span class="dossier-card-badge" style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #a5b4fc; font-family: var(--font-mono);">Executive Deliverable</span>
            <span class="dossier-card-chip" style="font-size: 0.65rem; padding: 1px 6px; border-radius: 4px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.25); font-family: var(--font-mono);">Slide Deck &amp; Print Ready</span>
          </div>
          <div class="dossier-card-title" style="font-size: 0.86rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">Enterprise Presentation Dossier</div>
          <div class="dossier-card-desc" style="font-size: 0.74rem; color: #94a3b8; line-height: 1.4; margin-bottom: 0.65rem;">Master cross-framework delivery record (SDLC &bull; ITIL &bull; PM &bull; Delivery)</div>
          <div class="dossier-card-actions" style="display: flex; align-items: center; gap: 0.5rem;">
            <button type="button" id="btn-sidebar-open-dossier" class="btn-dossier-launch" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 5px 10px; background: #4f46e5; color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 5px; font-size: 0.76rem; font-weight: 600; cursor: pointer;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <span>Open Inside Vault</span>
            </button>
            <a href="/presentation" target="_blank" class="btn-dossier-popout" title="Pop out presentation deck in new window" style="display: inline-flex; align-items: center; justify-content: center; padding: 5px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 5px; color: #94a3b8; cursor: pointer; text-decoration: none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
        </div>
        
        <div class="doc-list-container" id="doc-list-container" role="navigation" aria-label="Project Documents Tree">
          <!-- Dynamically populated document items -->
          <div class="loading-state">Scanning workspace repository documents...</div>
        </div>
      </aside>

      <!-- Right Main Stage: Document Viewer & Editor -->
      <section class="panel-card doc-stage-panel" aria-label="Document Viewer & Editor">
        <div class="panel-header stage-header">
          <div class="doc-meta-header">
            <h2 id="active-doc-title">Select a document to inspect</h2>
            <div class="doc-meta-sub">
              <span class="badge-category" id="active-doc-category">Category</span>
              <span class="badge-framework" id="active-doc-framework" style="display:none; font-size: 0.72rem; padding: 2px 7px; border-radius: 4px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">Framework</span>
              <span class="badge-stage" id="active-doc-stage" style="display:none; font-size: 0.72rem; padding: 2px 7px; border-radius: 4px; background: rgba(167, 139, 250, 0.15); color: #a78bfa; border: 1px solid rgba(167, 139, 250, 0.3);">Stage</span>
              <span class="doc-path-display" id="active-doc-path">Path: -</span>
              <span class="doc-date-display" id="active-doc-created" style="color: #38bdf8; border-color: rgba(56, 189, 248, 0.3);">Created: -</span>
              <span class="doc-date-display" id="active-doc-date">Modified: -</span>
            </div>
          </div>

          <div class="stage-actions">
            <div class="view-mode-toggle" role="group" aria-label="View Mode Toggle">
              <button class="toggle-btn active" id="btn-preview-mode" type="button">Preview</button>
              <button class="toggle-btn" id="btn-edit-mode" type="button">Editor</button>
              <button class="toggle-btn" id="btn-dossier-mode" type="button">Dossier View</button>
              <button class="toggle-btn" id="btn-blueprints-mode" type="button" style="color: #67e8f9; font-weight: 600;">🔐 Core IP &amp; Blueprints</button>
              <button class="toggle-btn" id="btn-api-catalog-mode" type="button" style="color: #c084fc; font-weight: 600;">🔌 Complete API Inventory</button>
              <button class="toggle-btn" id="btn-database-ssot-mode" type="button" style="color: #39ff14; font-weight: 600;">🗄️ Dual-DB SSoT</button>
            </div>
            <a id="btn-open-presentation" href="/presentation" target="_blank" class="btn-secondary" style="text-decoration: none;" title="Pop out full presentation deck in new tab">
              ↗ Pop Out
            </a>
            <button id="btn-copy-doc" class="btn-secondary" type="button">Copy</button>
            <button id="btn-save-doc" class="btn-primary" type="button" style="display: none;">Save Changes</button>
          </div>
        </div>

        <!-- Document Content Area -->
        <div class="doc-content-wrapper" style="display: flex; flex-direction: column; flex: 1;">
          <!-- Rendered Markdown View -->
          <div id="markdown-render-area" class="markdown-preview-pane" tabindex="0" aria-label="Rendered Document Content">
            <div class="placeholder-prompt">
              <h3><span class="dcouplr-bracket">&lt;</span><span class="dcouplr-text">dcouplr</span><span class="dcouplr-bracket">/&gt;</span> Project Record Assistant</h3>
              <p>Select any governance record, financial model, or technical architecture document from the sidebar to inspect its living contents.</p>
            </div>
          </div>

          <!-- Raw Editor View (hidden initially) -->
          <div id="editor-area" class="editor-pane" style="display: none;">
            <textarea 
              id="raw-doc-editor" 
              spellcheck="false" 
              aria-label="Raw Markdown Document Editor"
              placeholder="Edit document content..."
            ></textarea>
          </div>

          <!-- Embedded Presentation Dossier Area -->
          <div id="dossier-area" class="dossier-preview-pane" style="display: none; width: 100%; height: 100%; min-height: 720px; flex: 1;">
            <iframe id="dossier-iframe" src="/presentation" class="dossier-iframe" title="Presentation Dossier View" style="width: 100%; height: 100%; min-height: 720px; border: none; border-radius: 8px; display: block; background: #090d16;"></iframe>
          </div>

          <!-- 🔐 Confidential Core IP & Architectural Blueprints Vault Area -->
          <div id="blueprints-area" class="blueprints-preview-pane" style="display: none; width: 100%; height: 100%; overflow-y: auto; padding: 1.5rem; background: #0a0d14; color: #f8fafc;">
            <div style="max-width: 1100px; margin: 0 auto;">
              <!-- Header Banner -->
              <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(6, 182, 212, 0.1)); border: 1px solid rgba(99, 102, 241, 0.35); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                  <span style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #a5b4fc; background: rgba(99, 102, 241, 0.2); padding: 3px 10px; border-radius: 4px; border: 1px solid rgba(99, 102, 241, 0.4);">
                    RESTRICTED ARCHITECTURE VAULT &bull; NON-PUBLIC IP
                  </span>
                  <span style="font-size: 0.8rem; color: #34d399; font-weight: 600;">Governed Under NDA &bull; Class 4 Baseline</span>
                </div>
                <h2 style="font-size: 1.6rem; font-weight: 800; color: #ffffff; margin-bottom: 0.5rem;">
                  Proprietary Architecture &amp; System Implementation Blueprints
                </h2>
                <p style="font-size: 0.92rem; color: #94a3b8; line-height: 1.6; margin: 0;">
                  This vault stores internal engineering specifications, AST grammar compilation matrices, consensus ring buffer mechanics, and competitive cloud financial models. Relocated from public discovery to prevent competitor reverse engineering.
                </p>
              </div>

              <!-- Quick Links Bar -->
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem;">
                <a href="/docs/COMPILER_STUDIO_AND_OPERATIONAL_DASHBOARD_ARCHITECTURE_AND_RUNBOOK.html" target="_blank" style="padding: 6px 14px; border-radius: 6px; background: rgba(56,189,248,0.15); border: 1px solid rgba(56,189,248,0.35); color: #38bdf8; text-decoration: none; font-size: 0.82rem; font-weight: 700;">📡 SOP: Compiler vs Dashboard &amp; Presets Runbook ↗</a>
                <a href="/docs" target="_blank" style="padding: 6px 14px; border-radius: 6px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #cbd5e1; text-decoration: none; font-size: 0.82rem; font-weight: 600;">📖 Interactive Swagger Docs</a>
                <a href="#admin-color-matrix" style="padding: 6px 14px; border-radius: 6px; background: rgba(57,255,20,0.15); border: 1px solid rgba(57,255,20,0.4); color: #39ff14; text-decoration: none; font-size: 0.82rem; font-weight: 700;">🟢 Health Color Matrix &amp; Runbook</a>
                <a href="#admin-sre-navigator" style="padding: 6px 14px; border-radius: 6px; background: rgba(6,182,212,0.18); border: 1px solid rgba(6,182,212,0.4); color: #00e5ff; text-decoration: none; font-size: 0.82rem; font-weight: 700;">🛠️ SRE Troubleshooting Navigator</a>
                <a href="#admin-blueprints-grid" style="padding: 6px 14px; border-radius: 6px; background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.3); color: #22d3ee; text-decoration: none; font-size: 0.82rem; font-weight: 600;">🏗️ 10 Core Architecture Cards</a>
                <a href="#admin-invariant-calculus" style="padding: 6px 14px; border-radius: 6px; background: rgba(57,255,20,0.12); border: 1px solid rgba(57,255,20,0.3); color: #39ff14; text-decoration: none; font-size: 0.82rem; font-weight: 600;">📐 Invariant Calculus (Q_DCL)</a>
                <a href="#admin-finops-matrix" style="padding: 6px 14px; border-radius: 6px; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #34d399; text-decoration: none; font-size: 0.82rem; font-weight: 600;">💰 Multi-Cloud FinOps Matrix</a>
                <a href="#admin-ast-pipeline" style="padding: 6px 14px; border-radius: 6px; background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.3); color: #fbbf24; text-decoration: none; font-size: 0.82rem; font-weight: 600;">⚙️ AST Transpiler Spec</a>
