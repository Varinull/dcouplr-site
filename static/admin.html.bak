                <div id="admin-voe-alert-routing-architecture" style="margin-bottom: 3rem; background: linear-gradient(145deg, rgba(17, 24, 39, 0.95), rgba(15, 23, 42, 0.92)); border: 1px solid rgba(168, 85, 247, 0.45); border-radius: 12px; padding: 1.75rem; box-shadow: 0 10px 35px rgba(0, 0, 0, 0.5);">
                  <!-- Header Banner -->
