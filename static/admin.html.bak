                    <div style="display: inline-block; background: rgba(56, 189, 248, 0.15); border: 2px solid #38bdf8; border-radius: 8px; padding: 8px 24px; margin-bottom: 1.25rem;">
                      <span style="font-size: 0.95rem; font-weight: 800; color: #fff; font-family: var(--font-mono); letter-spacing: 0.05em;">
                        🛡️ <span class="dcouplr-wordmark"><span class="dcouplr-bracket">&lt;</span><span class="dcouplr-text">dcouplr</span><span class="dcouplr-bracket">/&gt;</span></span> ENTERPRISE PLATFORM
                      </span>
                    </div>

