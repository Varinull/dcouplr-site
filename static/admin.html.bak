                          <!-- Row 9: Layer 3 Firewalls -->
                          <tr class="layer-matrix-row" data-layer="Layer 3" data-severity="P1" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                            <td style="padding: 8px 10px; color: #fff;">
                              <span class="status-badge" style="background: rgba(168, 85, 247, 0.15); color: #c084fc; font-size: 0.65rem;">Layer 3</span><br>
