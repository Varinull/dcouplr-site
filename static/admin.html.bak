                <div id="admin-database-fleet-dossier" style="margin-bottom: 3rem; background: linear-gradient(145deg, rgba(15, 23, 42, 0.96), rgba(11, 17, 32, 0.94)); border: 1px solid rgba(56, 189, 248, 0.45); border-radius: 12px; padding: 1.75rem; box-shadow: 0 10px 35px rgba(0, 0, 0, 0.55);">
