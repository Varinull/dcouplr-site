# ==============================================================================
# <dcouplr/> Hostinger Production Apache / LiteSpeed Configuration
# Zero-Egress Observability & In-VPC Infrastructure Transpiler
# ==============================================================================

RewriteEngine On
DirectoryIndex index.html index.php

# 0. STRICT IN-VPC APPLIANCE BOUNDARY ENFORCEMENT
# The dashboard, admin vault, compiler studio, upgrade portal, internal tools, and legacy legal pages
# run strictly in-VPC or are disabled, and MUST NEVER be accessible on the public production website (https://dcouplr.com).
RewriteCond %{THE_REQUEST} \s/+*(dashboard|admin|compiler|telemetry|support|pitch|presentation|dossier|legal|upgrade) [NC,OR]
RewriteCond %{REQUEST_URI} ^/*(dashboard|admin|compiler|telemetry|support|pitch|presentation|dossier|legal|upgrade) [NC,OR]
RewriteCond %{REQUEST_URI} ^/*(dashboard|admin|compiler|support|pitch|presentation|legal_terms|legal_privacy|legal_security|upgrade)\.(html|js|css)$ [NC]
RewriteRule ^ - [R=404,L]

RewriteRule ^/*(dashboard|admin|compiler|telemetry|support|pitch|presentation|dossier|legal|upgrade)(/.*)?$ - [R=404,L]
RewriteRule ^/*(dashboard|admin|compiler|support|pitch|presentation|legal_terms|legal_privacy|legal_security|upgrade)\.(html|js|css)$ - [R=404,L]

# Prevent any caching on blocked appliance consoles
SetEnvIf Request_URI "^/*(dashboard|admin|compiler|telemetry|support|pitch|presentation|dossier|legal|upgrade)" NO_CACHE=1
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE
Header always set Pragma "no-cache" env=NO_CACHE
Header always set Expires "0" env=NO_CACHE

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Clean URLs (Route paths to corresponding .html files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tech Docs Portal
RewriteRule ^docs/?$ docs.html [L,QSA]
RewriteRule ^techdocs/?$ docs.html [L,QSA]
RewriteRule ^documentation/?$ docs.html [L,QSA]

# Swagger UI & OpenAPI Specification
RewriteRule ^docs/swagger/?$ swagger.html [L,QSA]
RewriteRule ^swagger/?$ swagger.html [L,QSA]
RewriteRule ^openapi\.json$ openapi.json [L]
RewriteRule ^SHA256SUMS$ SHA256SUMS [L]

# CLI Installers & Archive direct alias
RewriteRule ^install/?$ install.sh [L]
RewriteRule ^install\.ps1$ install.ps1 [L]
RewriteRule ^install-enterprise/?$ install-enterprise.sh [L]
RewriteRule ^install-enterprise\.ps1$ install-enterprise.ps1 [L]

# Community Core Lead Registration & Downloads API
RewriteRule ^v1/community/register/?$ register.php [L,QSA]
RewriteRule ^api/community/register/?$ register.php [L,QSA]
RewriteRule ^v1/community/stats/?$ register.php?action=stats [L,QSA]

# General .html fallback
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 4. Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
    <FilesMatch "\.md$">
        ForceType text/plain
        Header set Content-Type "text/plain; charset=utf-8"
    </FilesMatch>
</IfModule>

# 6. Markdown & Runbook MIME handling
AddType text/plain;charset=utf-8 .md


# 6. Default Charset
AddDefaultCharset UTF-8
